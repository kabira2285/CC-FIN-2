      "source": [
        "# Jeux publics de scikit-learn : pas de téléchargement ni de compte requis\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import load_diabetes, load_breast_cancer, load_wine, load_digits\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score, f1_score, silhouette_score, accuracy_score\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.decomposition import PCA\n",
        "GRAINE = 42\n",
        "\n",
        "jeu_reg = load_diabetes()\n",
        "X_reg, y_reg = jeu_reg.data, jeu_reg.target\n",
        "jeu_cls = load_breast_cancer()\n",
        "X_cls, y_cls = jeu_cls.data, jeu_cls.target\n",
        "jeu_groupes = load_wine()\n",
        "X_clu = PCA(n_components=2, random_state=GRAINE).fit_transform(StandardScaler().fit_transform(jeu_groupes.data))\n",
        "jeu_images = load_digits()\n",
        "X_images = StandardScaler().fit_transform(jeu_images.data)\n",
        "Xr_ent, Xr_test, yr_ent, yr_test = train_test_split(X_reg,y_reg,test_size=.25,random_state=GRAINE)\n",
        "Xc_ent, Xc_test, yc_ent, yc_test = train_test_split(X_cls,y_cls,test_size=.25,stratify=y_cls,random_state=GRAINE)\n",
        "print('Diabetes',X_reg.shape,'Breast cancer',X_cls.shape,'Wine',X_clu.shape,'Digits',X_images.shape)"
      ]
    },
