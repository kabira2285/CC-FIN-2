      "source": [
        "# Q-learning manuel sur Taxi-v4 : exploration epsilon-greedy\n",
        "import gymnasium as gym\n",
        "env=gym.make('Taxi-v4');Q=np.zeros((env.observation_space.n,env.action_space.n));generateur=np.random.default_rng(GRAINE)\n",
        "for episode in range(3000):\n",
        "    etat,_=env.reset(seed=GRAINE+episode);epsilon=max(.07,1-episode/2400)\n",
        "    for pas in range(200):\n",
        "        action=int(generateur.integers(env.action_space.n)) if generateur.random()<epsilon else int(np.argmax(Q[etat]))\n",
        "        suivant,recompense,termine,tronque,_=env.step(action)\n",
        "        cible=recompense+(0 if termine else .96*np.max(Q[suivant]))\n",
        "        Q[etat,action]+=.2*(cible-Q[etat,action]);etat=suivant\n",
        "        if termine or tronque:break\n",
        "print('Q-learning Taxi — taille de Q:',Q.shape,'Valeurs du premier état:',Q[0].round(2));env.close()"
      ]
