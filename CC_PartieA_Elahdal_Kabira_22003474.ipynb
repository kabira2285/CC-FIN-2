      "source": [
        "# Epsilon-greedy sur les mêmes 4 bras simulés\n",
        "generateur=np.random.default_rng(GRAINE)\n",
        "probabilites=np.array([.15,.4,.6,.75]);sommes=np.zeros(4);comptes=np.zeros(4,dtype=int);epsilon=.15\n",
        "for t in range(1200):\n",
        "    bras=int(generateur.integers(4)) if generateur.random()<epsilon else int(np.argmax((sommes+1)/(comptes+2)))\n",
        "    gain=int(generateur.random()<probabilites[bras]);sommes[bras]+=gain;comptes[bras]+=1\n",
        "print('Nombre de choix:',comptes,'Estimations:',(sommes/np.maximum(comptes,1)).round(3))"
      ]
