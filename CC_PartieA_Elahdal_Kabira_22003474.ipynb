        "    pred = modele.predict(X_test)\n",
        "    proba = modele.predict_proba(X_test)[:, 1]\n",
        "    print(nom, \"F1\", round(f1_score(y_test, pred), 3), \"ROC-AUC\", round(roc_auc_score(y_test, proba), 3))\n",
        "\n",
        "# Clustering : aucune cible utilisée pour construire les groupes\n",
        "X_wine = StandardScaler().fit_transform(load_wine().data)\n",
        "for nom, modele in [(\"K-means\", KMeans(n_clusters=3, n_init=20, random_state=42)), (\"Hiérarchique Ward\", AgglomerativeClustering(n_clusters=3, linkage=\"ward\"))]:\n",
        "    labels = modele.fit_predict(X_wine)\n",
        "    print(nom, \"silhouette\", round(silhouette_score(X_wine, labels), 3))\n",
        "\n",
        "# Réduction de dimension : mesures adaptées à chaque méthode\n",
        "X_digits = StandardScaler().fit_transform(load_digits().data[:600])\n",
        "pca = PCA(n_components=2, random_state=42).fit(X_digits)\n",
        "print(\"ACP — variance expliquée cumulée\", round(pca.explained_variance_ratio_.sum(), 3))\n",
        "proj_tsne = TSNE(n_components=2, perplexity=35, random_state=42, init=\"pca\").fit_transform(X_digits)\n",
        "print(\"t-SNE — trustworthiness (5 voisins)\", round(trustworthiness(X_digits, proj_tsne, n_neighbors=5), 3))\n",
        "\n",
        "# Anomalies : sans labels fiables, on compare uniquement le volume d'alertes\n",
        "for taux in [0.02, 0.05, 0.10]:\n",
        "    iso = IsolationForest(contamination=taux, n_estimators=150, random_state=42).fit(X_wine)\n",
        "    print(\"Isolation Forest — contamination\", taux, \"alertes\", int((iso.predict(X_wine) == -1).sum()))\n",
        "\n",
        "# Renforcement : comparaison de politiques sur un bandit simulé et plusieurs graines\n",
        "probabilites = np.array([0.15, 0.40, 0.60, 0.75])\n",
        "for politique in [\"aléatoire\", \"epsilon-greedy\"]:\n",
        "    recompenses_totales = []\n",
        "    for graine in range(20):\n",
        "        rng = np.random.default_rng(graine)\n",
        "        sommes = np.zeros(4); comptes = np.zeros(4); total = 0\n",
        "        for t in range(1200):\n",
        "            if politique == \"aléatoire\" or rng.random() < 0.15:\n",
        "                bras = int(rng.integers(4))\n",
        "            else:\n",
        "                bras = int(np.argmax((sommes + 1) / (comptes + 2)))\n",
        "            recompense = int(rng.random() < probabilites[bras])\n",
        "            sommes[bras] += recompense; comptes[bras] += 1; total += recompense\n",
        "        recompenses_totales.append(total)\n",
        "    print(politique, \"récompense moyenne ± écart-type\", round(np.mean(recompenses_totales), 1), \"±\", round(np.std(recompenses_totales), 1))\n"
