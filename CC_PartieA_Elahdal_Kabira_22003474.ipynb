      "source": [
        "# SARSA manuel sur Taxi-v4 (on-policy)\n",
        "import gymnasium as gym\n",
        "import numpy as np\n",
        "\n",
        "env=gym.make('Taxi-v4');Q=np.zeros((env.observation_space.n,env.action_space.n));generateur=np.random.default_rng(GRAINE)\n",
        "def choisir_action(etat,epsilon):\n",
        "    return int(generateur.integers(env.action_space.n)) if generateur.random()<epsilon else int(np.argmax(Q[etat]))\n",
        "for episode in range(3000):\n",
        "    etat,_=env.reset(seed=GRAINE+episode);epsilon=max(.07,1-episode/2400);action=choisir_action(etat,epsilon)\n",
        "    for pas in range(200):\n",
        "        suivant,recompense,termine,tronque,_=env.step(action)\n",
        "        action_suiv=choisir_action(suivant,epsilon)\n",
        "        cible=recompense+(0 if termine else .96*Q[suivant,action_suiv])\n",
        "        Q[etat,action]+=.2*(cible-Q[etat,action]);etat,action=suivant,action_suiv\n",
        "        if termine or tronque:break\n",
        "print('SARSA Taxi — taille de Q:',Q.shape,'Valeurs du premier état:',Q[0].round(2));env.close()"
      ]
    },
