        "# K-means manuel sur la projection Wine, avec centroïdes et inertie\n",
        "valeurs=X_clu.copy();k=3;generateur=np.random.default_rng(GRAINE)\n",
        "centroides=valeurs[generateur.choice(len(valeurs),size=k,replace=False)].copy()\n",
        "for iteration in range(100):\n",
        "    distances=((valeurs[:,None,:]-centroides[None,:,:])**2).sum(axis=2)\n",
        "    groupes=distances.argmin(axis=1)\n",
        "    nouveaux=np.array([valeurs[groupes==j].mean(axis=0) if np.any(groupes==j) else centroides[j] for j in range(k)])\n",
        "    if np.allclose(nouveaux,centroides):break\n",
        "    centroides=nouveaux\n",
        "inertie=np.sum((valeurs-centroides[groupes])**2)\n",
        "from sklearn.cluster import KMeans\n",
        "reference=KMeans(n_clusters=k,n_init=15,random_state=GRAINE).fit(valeurs)\n",
        "print('Inertie manuelle:',round(inertie,2),'Inertie sklearn:',round(reference.inertia_,2))\n",
        "# Attention : K-means est sensible à l'initialisation ; les deux inerties peuvent différer."
      ]
