        "modele=HistGradientBoostingClassifier(max_iter=100,max_leaf_nodes=10,random_state=GRAINE).fit(Xc_ent,yc_ent)\n",
        "print('F1:',f1_score(yc_test,modele.predict(Xc_test)))"
