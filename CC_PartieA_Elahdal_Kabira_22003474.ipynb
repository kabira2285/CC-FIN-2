        "from sklearn.datasets import make_regression, make_classification, make_blobs\n",
        "from IPython.display import display\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1) Régression synthétique\n",
        "X_s_reg, y_s_reg = make_regression(n_samples=100, n_features=1, noise=15, random_state=42)\n",
        "df_reg_s = pd.DataFrame({\"x\": X_s_reg[:, 0], \"y\": y_s_reg})\n",
        "print(\"Extrait régression synthétique :\")\n",
        "display(df_reg_s.head())\n",
        "plt.scatter(X_s_reg[:, 0], y_s_reg); plt.title(\"Données synthétiques — régression\"); plt.xlabel(\"x\"); plt.ylabel(\"y\"); plt.show()\n",
        "\n",
        "# 2) Classification synthétique\n",
        "X_s_cls, y_s_cls = make_classification(n_samples=100, n_features=2, n_redundant=0, n_informative=2, n_clusters_per_class=1, random_state=42)\n",
        "df_cls_s = pd.DataFrame({\"x1\": X_s_cls[:, 0], \"x2\": X_s_cls[:, 1], \"classe\": y_s_cls})\n",
        "print(\"Extrait classification synthétique :\")\n",
        "display(df_cls_s.head())\n",
        "plt.scatter(X_s_cls[:, 0], X_s_cls[:, 1], c=y_s_cls); plt.title(\"Données synthétiques — classification\"); plt.xlabel(\"x1\"); plt.ylabel(\"x2\"); plt.show()\n",
        "\n",
        "# 3) Clustering synthétique\n",
        "X_s_clu, _ = make_blobs(n_samples=100, centers=3, cluster_std=1.0, random_state=42)\n",
        "df_clu_s = pd.DataFrame(X_s_clu, columns=[\"x1\", \"x2\"])\n",
        "print(\"Extrait clustering synthétique :\")\n",
        "display(df_clu_s.head())\n",
        "plt.scatter(X_s_clu[:, 0], X_s_clu[:, 1]); plt.title(\"Données synthétiques — nuage de points\"); plt.xlabel(\"x1\"); plt.ylabel(\"x2\"); plt.show()"
