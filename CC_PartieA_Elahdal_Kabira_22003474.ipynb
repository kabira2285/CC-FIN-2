        "# Descente de gradient manuelle pour une régression linéaire sur Diabetes, avec 1 variable\n",
        "x=X_reg[:,2].copy();x=(x-x.mean())/x.std();y=y_reg.copy()\n",
        "poids=0.;biais=y.mean();pas=.015\n",
        "for iteration in range(3000):\n",
        "    erreur=poids*x+biais-y\n",
        "    poids-=pas*2*np.mean(erreur*x)\n",
        "    biais-=pas*2*np.mean(erreur)\n",
        "print('Manuel:',round(poids,3),round(biais,3))\n",
        "from sklearn.linear_model import LinearRegression\n",
        "modele_ref=LinearRegression().fit(x.reshape(-1,1),y)\n",
