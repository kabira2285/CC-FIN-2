      "source": [
        "from sklearn.cluster import DBSCAN\n",
        "etiquettes=DBSCAN(eps=.7,min_samples=6).fit_predict(X_clu)\n",
        "print('Groupes:',len(set(etiquettes)-{-1}),'Bruit:',int((etiquettes==-1).sum()))"
