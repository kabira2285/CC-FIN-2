      ],
      "source": [
        "from sklearn.ensemble import RandomForestRegressor\n",
        "modele=RandomForestRegressor(n_estimators=120,min_samples_leaf=4,random_state=GRAINE,n_jobs=-1).fit(Xr_ent,yr_ent)\n",
        "print('MAE:',mean_absolute_error(yr_test,modele.predict(Xr_test)))"
